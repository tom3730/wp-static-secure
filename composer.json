{
  "name": "tom3730/wp-static-secure",
  "description": "Static publishing foundation that keeps WordPress out of the public delivery path.",
  "type": "wordpress-plugin",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  },
  "autoload": {
    "psr-4": {
      "WPStaticSecure\\": "src/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
